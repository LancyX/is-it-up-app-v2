# Home Assistant
HA_BASE_URL=http://192.168.x.x:8123
HA_TOKEN=your_long_lived_access_token
GRID_ENTITY_ID=binary_sensor.grid_power

# Optional: DTEK outage schedule (region: kyiv-region, kyiv, dnipro or odesa; and queue)
# SCHEDULE_REGION=kyiv-region
# SCHEDULE_QUEUE=5.1
# Optional: what DTEK reports for your address, from the DTEK Monitor HACS integration
# ADDRESS_ENTITY_ID=sensor.dtek_krem_<id>_outage_status

# Frontend (optional; used at build time)
# VITE_CONTACT_EMAIL=your@email.com
# VITE_GITHUB_REPO_URL=https://github.com/your/repo
# Base path if app is served from a subpath (e.g. /is-it-up/). Default /
# VITE_BASE_PATH=/
# API path on same host (you route this in NPM). Default /api
# VITE_API_BASE=/api
# VITE_APP_SUBTITLE="My Custom Subtitle"
